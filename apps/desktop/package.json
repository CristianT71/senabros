{
  "name": "senabros-desktop",
  "version": "1.0.0",
  "description": "SENA Bros para Windows",
  "author": "CristianT71",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.senabros.game",
    "productName": "SENA Bros",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../www",
        "to": "www"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "SenaBros-Setup.exe",
      "shortcutName": "SENA Bros",
      "deleteAppDataOnUninstall": false
    },
    "protocols": [{ "name": "SENA Bros", "schemes": ["senabros"] }],
    "publish": [
      {
        "provider": "github",
        "owner": "CristianT71",
        "repo": "senabros",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  }
}
